config:
  theme: base
  flowchart:
    curve: basis
    nodeSpacing: 38
    rankSpacing: 44
    wrappingWidth: 220
  themeVariables:
    background: '#ffffff'
    primaryTextColor: '#18324a'
    lineColor: '#73869a'
