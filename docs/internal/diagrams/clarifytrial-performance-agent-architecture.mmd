flowchart TD
    %% ClarifyTrial v5 performance architecture
    %% Design only. ClarifyTrial v5 has not been experimentally measured.

    subgraph OFFLINE[1. 임상시험마다 한 번 준비]
        T0[버전이 확인된 임상시험 원문]
        T1[선정·제외 조건을 한 문장씩 분리]
        T2[수치·기간·AND·OR·부정·예외와<br/>원문 위치를 함께 저장]
        T3[코드로 단위·날짜·비교 방법 검사]
        T4{정리한 조건이 원문과 맞는가}
        TS[검색 색인과 조건 저장소]
        TH[자동 판정에 쓰지 않고<br/>조건 정리 검토 필요로 표시]

        T0 --> T1 --> T2 --> T3 --> T4
        T4 -->|예| TS
        T4 -->|아니오| TH
    end

    subgraph PATIENT[2. 환자마다 같은 상태표 사용]
        P0[현재까지 확보한 합성 환자 기록]
        P1[진단·치료·검사·날짜·출처 정리]
        PS[환자 상태표<br/>원문 위치·사건 날짜·자료 종류·직접 사실 또는 추정]
        PC[서로 다른 기록이 충돌하면<br/>한쪽을 지우지 않고 둘 다 보존]

        P0 --> P1 --> PS --> PC
    end

    subgraph SEARCH[3. 후보를 넓게 찾고 관련 조건을 먼저 봄]
        S0[모집 상태와 명확한 나이·성별·지역만 규칙으로 확인]
        S1[글자 일치 검색]
        S2[의미가 비슷한 내용 검색]
        S3[두 검색 결과 결합]
        S4[환자와 관련 있는 시험 조건을 위로 재정렬]
        S5[넓게 남긴 후보 시험]

        S0 --> S1
        S0 --> S2
        S1 --> S3
        S2 --> S3
        S3 --> S4 --> S5
    end

    TS --> S0
    PC --> S0

    subgraph JUDGMENT[4. 조건별 판단과 한 번의 근거 검사]
        J0[선정 조건별 판단]
        J1[제외 조건별 판단]
        JT[조건별 결과<br/>상태·환자 근거·시험 원문·부족 정보]
        JA[환자 원문·시험 원문·기준일 대조<br/>날짜·수치·단위·부정·논리 검사]
        AG[조건 결과를 시험별로 모음]
        G1[후보 유지 판단<br/>유지·제거·판단 어려움]
        G2[현재 확정 판단<br/>확정·미확정·부적합·판단 어려움]
        CS[현재 후보와 미해결 조건]

        J0 --> JT
        J1 --> JT
        JT --> JA --> AG
        AG --> G1 --> CS
        AG --> G2 --> CS
    end

    S5 --> J0
    S5 --> J1
    TS --> J0
    TS --> J1
    PC --> J0
    PC --> J1

    subgraph CONTROL[5. 현재 자료로 충분한지 보고 다음 확인 선택]
        PH{현재 대화 목적}
        ENOUGH{중요 후보를 지금 자료로<br/>결정할 수 있는가}
        MISSING[판정을 바꿀 수 있는 부족 정보만 모음]
        A0[사용 가능한 확인 경로 만들기]
        A1[기존 기록 조회]
        A2[환자가 답할 수 있는 질문]
        A3[공식 검사 결과나 의료진 확인 요청]
        A4[지금은 보류]
        SAFE[환자가 답할 수 없는 질문과<br/>자동 검사 주문 같은 행동 제거]
        PRIORITY[우선순위 비교<br/>중요 조건 해결 가능성·영향 후보 수·답의 신뢰도<br/>환자 부담·위험·대기·비용·성급한 후보 제거 위험]
        NEXT[가장 적절한 다음 확인 하나]

        PH -->|기본 정보 확인| ENOUGH
        PH -->|상세 조건 확인| ENOUGH
        PH -->|최종 확인| ENOUGH
        ENOUGH -->|아니오| MISSING --> A0
        A0 --> A1
        A0 --> A2
        A0 --> A3
        A0 --> A4
        A1 --> SAFE
        A2 --> SAFE
        A3 --> SAFE
        A4 --> SAFE
        SAFE --> PRIORITY --> NEXT
    end

    CS --> PH

    subgraph ENVIRONMENT[6. 판단 시스템과 분리된 합성 답변 환경]
        E1[미리 만든 합성 EHR에서 기록 조회]
        E2[숨긴 합성 사실 카드에서 환자 답변]
        E3[미리 정한 공식 확인 결과와 이용 가능 시점]
        E4[새 정보에 출처와 사건 날짜를 붙임]
        E5[환자 상태표 갱신]

        E1 --> E4
        E2 --> E4
        E3 --> E4
        E4 --> E5
    end

    NEXT -->|기록 조회| E1
    NEXT -->|환자 질문| E2
    NEXT -->|공식 확인| E3

    E5 -->|검색 조건이 달라짐| S0
    E5 -->|관련 조건 근거가 달라짐| J0
    E5 -->|관련 조건 근거가 달라짐| J1

    subgraph OUTPUT[7. 종료와 결과]
        STOP{종료}
        O1[후보로 계속 검토할 시험]
        O2[현재 자료로 확정된 범위]
        O3[판단에 사용한 환자 원문과 시험 원문]
        O4[남은 정보와 올바른 확인 경로]
        O5[새 정보 전후에 달라진 조건]

        STOP --> O1
        STOP --> O2
        STOP --> O3
        STOP --> O4
        STOP --> O5
    end

    ENOUGH -->|예| STOP
    NEXT -->|보류 또는 행동 한도| STOP
    CS -->|환자가 현재 후보를 보고 중단| STOP

    classDef source fill:#E8F1FF,stroke:#2B5FAB,color:#10233F;
    classDef model fill:#FFF2CC,stroke:#A87500,color:#3A2800;
    classDef code fill:#E2F0D9,stroke:#4C7A34,color:#17300E;
    classDef decision fill:#FCE4EC,stroke:#AD3E62,color:#421326;
    classDef result fill:#EDE7F6,stroke:#6B4AA0,color:#26183C;
    classDef warning fill:#FADBD8,stroke:#A63D32,color:#451411;

    class T0,P0,TS,PS,PC source;
    class T1,T2,P1,S4,J0,J1,JT,MISSING model;
    class T3,S0,S1,S2,S3,JA,SAFE,PRIORITY,E1,E2,E3,E4,E5 code;
    class T4,PH,ENOUGH,STOP decision;
    class TH warning;
    class S5,AG,G1,G2,CS,NEXT,O1,O2,O3,O4,O5 result;
