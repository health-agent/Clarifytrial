---
title: 환자 한 사례의 상세 실행 흐름
config:
  theme: base
  flowchart:
    curve: basis
    nodeSpacing: 28
    rankSpacing: 48
    wrappingWidth: 190
  themeVariables:
    background: '#ffffff'
    primaryTextColor: '#18324a'
    lineColor: '#73869a'
    edgeLabelBackground: '#ffffff'
    fontFamily: 'Pretendard, Noto Sans KR, Malgun Gothic, sans-serif'
---
flowchart TB
    subgraph A["1. 입력과 준비"]
        direction LR
        I[["환자 기록 · 시험 문서<br/>환자 상황 · 확인 횟수"]]
        F{"구조화 JSON인가?"}
        P1["모델 역할 1 · 선택<br/>환자 기록 정리"]
        P2["모델 역할 2 · 선택<br/>시험 조건 정리"]
        K["코드 검사<br/>수치 · 날짜 · 비교 방향 · 출처"]
        S["코드<br/>모집 상태 확인 · 관련 시험 검색"]
        I --> F
        F -->|예| S
        F -.->|아니요| P1
        F -.->|아니요| P2
        P1 --> K
        P2 --> K
        K --> S
    end

    subgraph B["2. 조건 판단"]
        direction LR
        L["코드<br/>새 정보와 관련된 조건만 불러오기"]
        C{"코드로 계산할 수 있는가?"}
        C1["코드<br/>수치 · 날짜 · 참거짓 · 복합 조건"]
        C2["모델 역할 3 · 선택<br/>구조화하지 못한 조건 판단"]
        E["코드<br/>환자·시험 근거와 평가 시각 확인"]
        J["코드<br/>후보 유지 · 현재 확인 상태 집계"]
        X{"실제 근거 충돌이 있는가?"}
        V["모델 역할 5 · 선택<br/>근거 충돌 검토"]
        L --> C
        C -->|예| C1
        C -.->|아니요| C2
        C1 --> E
        C2 --> E
        E --> J
        J --> X
        X -.->|예| V
    end

    subgraph C["3. 다음 정보 선택"]
        direction LR
        U{"확인할 정보와<br/>남은 횟수가 있는가?"}
        G["코드<br/>미확인 정보와 영향받는 시험 연결"]
        R["코드<br/>남은 횟수 안의 정보 조합 계산"]
        P["코드<br/>환자가 이용할 수 없는 방법 제거"]
        Z["코드<br/>완료 가능 수와 검사·방문 부담으로 선택"]
        Q["모델 역할 4 · 선택<br/>질문 또는 요청문 작성"]
        U -->|예| G
        G --> R
        R --> P
        P --> Z
        Z -.->|자연스러운 문장이 필요할 때| Q
    end

    subgraph D["4. 확인·재판정·결과"]
        direction LR
        M{"확인 방법"}
        M1["병원·기존 기록"]
        M2["환자 답변"]
        M3["기존 공식 결과"]
        M4["새 검사 또는 평가"]
        H["정보 제공<br/>실험에서는 미리 만든 합성 답만 반환"]
        Y{"답을 얻었는가?"}
        N1["코드<br/>새 사실·출처·날짜를 상태표에 추가"]
        N2["코드<br/>이번 실행에서 같은 정보 재확인 금지"]
        T["코드<br/>관련 조건만 다시 판단하고 필요한 만큼 반복"]
        O["결과<br/>현재 확인된 시험 · 추가 확인 후보 · 조건 불충족<br/>근거 · 남은 정보 · 질문 전후 변화 · 검사와 방문"]
        M --> M1
        M --> M2
        M --> M3
        M --> M4
        M1 --> H
        M2 --> H
        M3 --> H
        M4 --> H
        H --> Y
        Y -->|예| N1
        Y -->|아니요| N2
        N1 --> T
        N2 --> T
        T --> O
    end

    S --> L
    X -->|아니요| U
    V -->|검토 뒤| U
    U -->|아니요| O
    Z -->|정해진 문장 사용| M
    Q --> M

    classDef model fill:#edf4ff,stroke:#365f91,stroke-width:2px,stroke-dasharray:6 4,color:#18324a;
    classDef code fill:#f7f9fc,stroke:#8a98a8,stroke-width:1.5px,color:#304457;
    classDef decision fill:#ffffff,stroke:#365f91,stroke-width:1.8px,color:#18324a;
    classDef output fill:#365f91,stroke:#365f91,stroke-width:2px,color:#ffffff;

    class P1,P2,C2,V,Q model;
    class I,K,S,L,C1,E,J,G,R,P,Z,M1,M2,M3,M4,H,N1,N2,T code;
    class F,C,X,U,M,Y decision;
    class O output;
    linkStyle default stroke:#73869a,stroke-width:1.5px;
