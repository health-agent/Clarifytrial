        "allocation": "RANDOMIZED",
        "interventionModel": "PARALLEL",
        "primaryPurpose": "TREATMENT",
        "maskingInfo": {
          "masking": "DOUBLE",
          "maskingDescription": "The study participants, Investigator, and study site staff, Sponsor will be blinded to treatment assignments (ABX-002 or placebo solution).",
          "whoMasked": [
